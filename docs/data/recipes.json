    "category": "家常菜",
    "tags": ["素食", "快手菜", "下饭"],
    "time": "10分钟",
    "difficulty": "简单",
    "ingredients": [
      {"name": "土豆", "amount": "2个"},
      {"name": "干辣椒", "amount": "5个"},
      {"name": "蒜", "amount": "2瓣"},
      {"name": "青椒", "amount": "1个"}
    ],
    "seasonings": ["醋", "盐", "花椒", "食用油"],
    "steps": [
