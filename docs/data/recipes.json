[
  {
    "name": "番茄炒蛋",
    "category": "家常菜",
    "tags": ["荤素", "快手菜", "下饭"],
    "time": "15分钟",
    "difficulty": "简单",
    "ingredients": [
      {"name": "番茄", "amount": "2个"},
      {"name": "鸡蛋", "amount": "3个"}
    ],
    "seasonings": ["盐", "白糖", "料酒", "食用油"],
    "steps": [
      "番茄洗净切块，鸡蛋打散加少许盐和料酒",
      "热锅倒油，倒入蛋液炒至凝固盛出",
      "锅中再加少许油，放入番茄翻炒出汁",
      "加入炒好的鸡蛋，放盐和白糖调味",
      "翻炒均匀即可出锅"
    ],
    "tips": "加一点糖能提鲜，番茄尽量选熟透的更容易出汁"
  },
  {
    "name": "青椒肉丝",
    "category": "家常菜",
    "tags": ["荤菜", "下饭"],
    "time": "20分钟",
    "difficulty": "中等",
    "ingredients": [
      {"name": "猪里脊", "amount": "200克"},
      {"name": "青椒", "amount": "2个"},
      {"name": "姜", "amount": "3片"}
    ],
    "seasonings": ["生抽", "老抽", "淀粉", "料酒", "盐", "胡椒粉", "食用油"],
    "steps": [
      "猪肉切丝，加生抽、料酒、淀粉、胡椒粉抓匀腌制10分钟",
      "青椒去籽切丝，姜切丝",
      "热锅凉油，下肉丝滑炒至变色盛出",
      "锅中留底油，爆香姜丝，下青椒丝翻炒",
      "加入肉丝，生抽调味，翻炒均匀即可"
    ],
    "tips": "肉丝腌制时淀粉不能少，这样炒出来才嫩"
  },
  {
    "name": "麻婆豆腐",
    "category": "川菜",
    "tags": ["荤菜", "下饭", "辣"],
    "time": "25分钟",
    "difficulty": "中等",
    "ingredients": [
      {"name": "嫩豆腐", "amount": "1块"},
      {"name": "猪肉末", "amount": "100克"},
      {"name": "蒜", "amount": "3瓣"},
      {"name": "葱", "amount": "1根"}
    ],
    "seasonings": ["豆瓣酱", "花椒粉", "辣椒面", "生抽", "淀粉", "食用油"],
    "steps": [
      "豆腐切小块，沸水中加盐焯水1分钟捞出",
      "热锅倒油，下肉末炒至变色",
      "加入豆瓣酱炒出红油，放蒜末、辣椒面",
      "加入适量清水和生抽，放入豆腐小火煮5分钟",
      "淋入水淀粉勾芡，撒花椒粉和葱花"
    ],
    "tips": "豆腐焯水可以去豆腥味且不易碎，勾芡分两次更入味"
  },
  {
    "name": "蒜蓉西兰花",
    "category": "素菜",
    "tags": ["素食", "快手菜", "健康"],
    "time": "10分钟",
    "difficulty": "简单",
    "ingredients": [
      {"name": "西兰花", "amount": "1颗"},
      {"name": "蒜", "amount": "5瓣"}
    ],
    "seasonings": ["盐", "蚝油", "食用油"],
    "steps": [
      "西兰花掰小朵，沸水中加盐和几滴油焯烫2分钟捞出",
      "蒜切蒜蓉",
      "热锅倒油，下蒜蓉爆香",
      "放入西兰花，加蚝油和盐翻炒均匀"
    ],
    "tips": "焯水时加盐和油能让西兰花保持翠绿"
  },
  {
    "name": "可乐鸡翅",
    "category": "家常菜",
    "tags": ["荤菜", "甜口", "下饭"],
    "time": "30分钟",
    "difficulty": "简单",
    "ingredients": [
      {"name": "鸡翅中", "amount": "8个"},
      {"name": "可乐", "amount": "1罐"},
      {"name": "姜", "amount": "3片"}
    ],
    "seasonings": ["生抽", "老抽", "料酒", "食用油"],
    "steps": [
      "鸡翅两面各划两刀，冷水下锅加姜片料酒焯水",
      "热锅倒油，鸡翅煎至两面金黄",
      "倒入可乐，加生抽、老抽调味",
      "大火烧开转中小火焖15分钟",
      "大火收汁至浓稠"
    ],
    "tips": "收汁时要不停翻动防止糊锅"
  },
  {
    "name": "红烧排骨",
    "category": "硬菜",
    "tags": ["荤菜", "下饭"],
    "time": "50分钟",
    "difficulty": "较难",
    "ingredients": [
      {"name": "猪肋排", "amount": "500克"},
      {"name": "姜", "amount": "5片"},
      {"name": "葱", "amount": "1根"}
    ],
    "seasonings": ["冰糖", "生抽", "老抽", "料酒", "八角", "桂皮", "食用油"],
    "steps": [
