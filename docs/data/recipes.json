      "下土豆丝大火翻炒",
      "加醋、盐、青椒丝，炒匀即可"
    ],
    "tips": "土豆丝切好后一定要泡水，炒出来才脆"
  },
  {
    "name": "葱油拌面",
    "category": "面食",
    "tags": ["素食", "快手菜"],
    "time": "15分钟",
    "difficulty": "简单",
    "ingredients": [
      {"name": "面条", "amount": "200克"},
      {"name": "小葱", "amount": "1把"}
    ],
    "seasonings": ["生抽", "老抽", "白糖", "食用油"],
    "steps": [
      "小葱切段，葱白葱绿分开",
      "冷锅倒油，小火慢炸葱白和葱绿至焦黄",
      "捞出葱渣，油中加生抽、老抽、白糖调成葱油",
      "面条煮熟捞出，淋上葱油拌匀"
    ],
    "tips": "葱油可以一次多熬一些，密封冷藏保存一周"
  }
